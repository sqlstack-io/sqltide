              "--- current",
              "+++ desired",
              "@@ -0,0 +1,25 @@",
              "+CREATE MATERIALIZED VIEW analytics.mv__orders_enriched",
              "+TO analytics.tbl__orders_enriched AS",
              "+SELECT",
